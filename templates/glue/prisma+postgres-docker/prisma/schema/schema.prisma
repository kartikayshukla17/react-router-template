// Starter Prisma schema for the demo `/notes` route — standard
// `prisma-client-js` generator, no driver adapter: a self-hosted Docker
// Postgres container speaks the normal Postgres wire protocol, which
// Prisma's own query engine talks to directly.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// `userId` stores the auth provider's user id as plain text, not a foreign
// key — per PRD.md's documented tradeoff, there's no user-sync table for
// third-party auth in v1, so this schema stays correct even if a
// non-Prisma-backed auth provider is swapped in later.
model Note {
  id        String   @id
  userId    String   @map("user_id")
  title     String
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notes")
}
